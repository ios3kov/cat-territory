{
  "name": "vite-react-app",
  "private": true,
  "version": "1.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "profile": "npm run build && node scripts/profile.mjs",
    "test:e2e": "playwright test",
    "test:offline": "playwright test -c playwright.offline.config.ts",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src e2e e2e-offline scripts *.ts *.js *.json .github/workflows/*.yml",
    "format:check": "prettier --check src e2e e2e-offline scripts *.ts *.js *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "postcss": "^8.4.0",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.70.0",
    "vite": "^6.0.0"
  }
}
